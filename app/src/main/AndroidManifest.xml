<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Plugin Lab only: network + shared-storage access used by plugin/runtime diagnostics. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".core.application.OperitApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_simple"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_simple_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Operit"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        tools:replace="android:allowBackup,android:icon,android:roundIcon,android:theme">

        <!-- Keep WorkManager dormant: Plugin Lab does not run workflow/background scheduling. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".ui.pluginlab.PluginLabActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Operit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Internal diagnostic fallback only; not exposed as a Lab feature. -->
        <activity
            android:name=".ui.error.CrashReportActivity"
            android:exported="false"
            android:label="@string/title_activity_crash_report"
            android:process=":crash"
            android:theme="@style/Theme.Operit" />

    </application>
</manifest>
