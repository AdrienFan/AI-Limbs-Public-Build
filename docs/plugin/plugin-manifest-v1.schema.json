{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-limbs:plugin-manifest:v1",
  "title": "AI Limbs Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "plugin_id",
    "version",
    "api",
    "display",
    "activation",
    "runtime"
  ],
  "properties": {
    "format": { "const": "AIL_PLUGIN_V1" },
    "schema_version": { "const": 1 },
    "plugin_id": { "$ref": "#/$defs/pluginId" },
    "version": { "$ref": "#/$defs/semver" },
    "api": { "$ref": "#/$defs/api" },
    "display": { "$ref": "#/$defs/display" },
    "roles": { "$ref": "#/$defs/symbolicArray" },
    "activation": { "$ref": "#/$defs/activation" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "dependencies": { "$ref": "#/$defs/dependencies" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "provides": { "$ref": "#/$defs/provides" },
    "ui": { "type": "object" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "symbolicId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9]+(?:[._:/-][A-Za-z0-9]+)*$"
    },
    "extensionPoint": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "target"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "target": { "type": "integer", "minimum": 1 }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "icon": { "$ref": "#/$defs/safeRelativePath" }
      }
    },
    "symbolicArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/symbolicId" }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["hot", "restart_required", "cold_extension"]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["toolpkg", "none", "declarative", "wasm", "android_extension"]
        },
        "entry": { "$ref": "#/$defs/safeRelativePath" },
        "config": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "not": { "const": "none" } } }, "required": ["kind"] },
          "then": { "required": ["entry"] }
        }
      ]
    },
    "pluginDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/pluginId" },
        "min_version": { "$ref": "#/$defs/semver" }
      }
    },
    "serviceDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/symbolicId" },
        "min_api": { "type": "integer", "minimum": 1 }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugins": {
          "type": "array",
          "items": { "$ref": "#/$defs/pluginDependency" }
        },
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/serviceDependency" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_scopes": { "$ref": "#/$defs/symbolicArray" }
      }
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^plugin\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "id", "api"],
      "properties": {
        "point": { "$ref": "#/$defs/extensionPoint" },
        "id": { "$ref": "#/$defs/symbolicId" },
        "api": { "type": "integer", "minimum": 1 }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capabilityId" }
        },
        "services": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/symbolicId" }
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/symbolicId" }
        },
        "extensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/extension" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signer_id", "entry"],
      "properties": {
        "algorithm": { "$ref": "#/$defs/symbolicId" },
        "signer_id": { "$ref": "#/$defs/symbolicId" },
        "entry": { "$ref": "#/$defs/safeRelativePath" }
      }
    }
  }
}
