{
  "format": "AIL_PLUGIN_V1",
  "schema_version": 1,
  "plugin_id": "plugin.system.environment_center",
  "version": "0.1.0",
  "api": {
    "target": 1,
    "min": 1
  },
  "display": {
    "name": "系统环境中心",
    "description": "系统环境中心父级插件；当前内置 Ubuntu 迁移子系统，后续统一承载 Ubuntu、Winlator 等系统环境。"
  },
  "roles": [
    "system_environment_center"
  ],
  "activation": {
    "mode": "hot"
  },
  "runtime": {
    "kind": "android_inprocess",
    "entry": "payload/plugin.apk",
    "config": {
      "entry_class": "com.ai.limbs.plugins.systemenvironment.SystemEnvironmentCenterEntry"
    }
  },
  "dependencies": {
    "plugins": [],
    "services": []
  },
  "permissions": {
    "requested_scopes": [
      "host.network@1",
      "host.ui.presentation@1"
    ]
  },
  "provides": {
    "capabilities": [
      "plugin.system_environment.ubuntu.status",
      "plugin.system_environment.ubuntu.start",
      "plugin.system_environment.ubuntu.stop",
      "plugin.system_environment.ubuntu.idle.get",
      "plugin.system_environment.ubuntu.idle.set",
      "plugin.system_environment.ubuntu.session.create",
      "plugin.system_environment.ubuntu.session.execute",
      "plugin.system_environment.ubuntu.command",
      "plugin.system_environment.ubuntu.filesystem",
      "plugin.system_environment.ubuntu.process",
      "plugin.system_environment.ubuntu.session.input",
      "plugin.system_environment.ubuntu.session.interrupt",
      "plugin.system_environment.ubuntu.session.screen",
      "plugin.system_environment.ubuntu.session.close"
    ],
    "services": [],
    "providers": [
      "plugin.system_environment_center.page"
    ],
    "extensions": [
      {
        "point": "ai_limbs.ui.home_tile",
        "id": "plugin.system.environment_center.tile",
        "api": 1
      },
      {
        "point": "ai_limbs.ui.screen",
        "id": "plugin.system_environment_center.screen",
        "api": 2
      }
    ]
  }
}
