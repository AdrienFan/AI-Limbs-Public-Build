{
  "format": "AIL_PLUGIN_V1",
  "schema_version": 1,
  "plugin_id": "plugin.system.developer_guide",
  "version": "1.1.0",
  "api": {
    "target": 1,
    "min": 1
  },
  "display": {
    "name": "开发说明",
    "description": "AI Limbs 当前插件开发、升级、安全与维护恢复手册；同时提供 AI 可调用只读接口。"
  },
  "roles": [
    "system_plugin"
  ],
  "activation": {
    "mode": "hot"
  },
  "runtime": {
    "kind": "android_inprocess",
    "entry": "payload/plugin.apk",
    "config": {
      "entry_class": "com.ai.limbs.plugins.developerguide.DeveloperGuideEntry"
    }
  },
  "dependencies": {
    "plugins": [],
    "services": []
  },
  "permissions": {
    "requested_scopes": []
  },
  "provides": {
    "capabilities": [
      "plugin.developer_guide.handbook",
      "plugin.developer_guide.section"
    ],
    "services": [],
    "providers": [
      "plugin.developer_guide.mechanism",
      "plugin.developer_guide.ailp",
      "plugin.developer_guide.ailpsys",
      "plugin.developer_guide.ailx",
      "plugin.developer_guide.ui",
      "plugin.developer_guide.security",
      "plugin.developer_guide.maintenance"
    ],
    "extensions": [
      {
        "point": "ai_limbs.ui.home_tile",
        "id": "plugin.system.developer_guide.tile",
        "api": 1
      },
      {
        "point": "ai_limbs.ui.screen",
        "id": "plugin.system.developer_guide.screen",
        "api": 1
      }
    ]
  }
}
