{
  "format": "AIL_PLUGIN_V1",
  "schema_version": 1,
  "plugin_id": "plugin.system.visual_manager",
  "version": "0.2.10",
  "api": {
    "target": 1,
    "min": 1
  },
  "display": {
    "name": "视觉工作台",
    "description": "通用视觉工作台：统一 RGBA 采样、动态场景策略、点击后旋转观察与清晰参数错误。完整功能需基座 build113，各桥共用统一能力入口。"
  },
  "roles": [
    "system_plugin"
  ],
  "activation": {
    "mode": "hot"
  },
  "runtime": {
    "kind": "android_inprocess",
    "entry": "payload/plugin.apk",
    "config": {
      "entry_class": "com.ai.limbs.plugins.visualmanager.VisualManagerEntry",
      "presentation_entry_class": "com.ai.limbs.plugins.visualmanager.VisualManagerPresentationEntry"
    }
  },
  "dependencies": {
    "plugins": [],
    "services": []
  },
  "permissions": {
    "requested_scopes": [
      "host.screen.capture@1",
      "host.screen.session@1",
      "host.camera.capture@1",
      "host.camera.session@1",
      "host.ui.automation@1",
      "host.permission@1"
    ]
  },
  "provides": {
    "capabilities": [
      "plugin.system.visual_manager.status",
      "plugin.system.visual_manager.sources",
      "plugin.system.visual_manager.permission",
      "plugin.system.visual_manager.start",
      "plugin.system.visual_manager.frame",
      "plugin.system.visual_manager.capture",
      "plugin.system.visual_manager.stop",
      "plugin.system.visual_manager.preview.read",
      "plugin.system.visual_manager.preview.save",
      "plugin.system.visual_manager.images.list",
      "plugin.system.visual_manager.images.read",
      "plugin.system.visual_manager.images.delete",
      "plugin.system.visual_manager.images.clear",
      "plugin.system.visual_manager.page.inspect",
      "plugin.system.visual_manager.page.text",
      "plugin.system.visual_manager.get_frame",
      "plugin.system.visual_manager.tap_on_frame",
      "plugin.system.visual_manager.wait_for_visual_change",
      "plugin.system.visual_manager.wait_until_stable",
      "plugin.system.visual_manager.observe",
      "plugin.system.visual_manager.page.nodes"
    ],
    "services": [],
    "providers": [
      "plugin.system.visual_manager.page",
      "plugin.system.visual_manager.state",
      "plugin.system.visual_manager.operation_feedback",
      "plugin.system.visual_manager.message_context"
    ],
    "extensions": [
      {
        "point": "ai_limbs.ui.home_tile",
        "id": "plugin.system.visual_manager.tile",
        "api": 1
      },
      {
        "point": "ai_limbs.ui.screen",
        "id": "plugin.system.visual_manager.screen",
        "api": 2
      }
    ]
  }
}
