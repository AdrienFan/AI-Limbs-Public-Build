{
  "format": "AIL_PLUGIN_V1",
  "schema_version": 1,
  "plugin_id": "plugin.system.log_center",
  "version": "0.1.0",
  "api": {
    "target": 1,
    "min": 1
  },
  "display": {
    "name": "日志中心",
    "description": "动态查看、搜索来源并按基座、父插件或子插件读取与导出 AI Limbs 日志。"
  },
  "roles": [
    "system_plugin"
  ],
  "activation": {
    "mode": "hot"
  },
  "runtime": {
    "kind": "android_inprocess",
    "entry": "payload/plugin.apk",
    "config": {
      "entry_class": "com.ai.limbs.plugins.logcenter.LogCenterEntry"
    }
  },
  "dependencies": {
    "plugins": [],
    "services": []
  },
  "permissions": {
    "requested_scopes": [
      "host.logging@1"
    ]
  },
  "provides": {
    "capabilities": [],
    "services": [],
    "providers": [
      "plugin.system.log_center.page"
    ],
    "extensions": [
      {
        "point": "ai_limbs.ui.home_tile",
        "id": "plugin.system.log_center.tile",
        "api": 1
      },
      {
        "point": "ai_limbs.ui.screen",
        "id": "plugin.system.log_center.screen",
        "api": 2
      }
    ]
  }
}
