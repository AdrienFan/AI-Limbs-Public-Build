{
  "format": "AIL_PLUGIN_V1",
  "schema_version": 1,
  "plugin_id": "plugin.system.ubuntu_terminal",
  "version": "0.3.2",
  "api": {
    "target": 1,
    "min": 1
  },
  "display": {
    "name": "Ubuntu命令终端",
    "description": "自持有 Ubuntu Runtime、PTY、rootfs 与终端资源，并通过 Host Native Runtime v1 使用 Android 安装期原生执行底座，保留 0.6.4.7.8 终端工作台交互。"
  },
  "roles": [
    "ubuntu_terminal"
  ],
  "activation": {
    "mode": "hot"
  },
  "runtime": {
    "kind": "android_inprocess",
    "entry": "payload/plugin.apk",
    "config": {
      "entry_class": "com.ai.limbs.plugins.ubuntu.UbuntuTerminalEntry"
    }
  },
  "dependencies": {
    "plugins": [],
    "services": []
  },
  "permissions": {
    "requested_scopes": []
  },
  "provides": {
    "capabilities": [
      "plugin.ubuntu.status",
      "plugin.ubuntu.start",
      "plugin.ubuntu.stop",
      "plugin.ubuntu.idle.get",
      "plugin.ubuntu.idle.set",
      "plugin.ubuntu.session.create",
      "plugin.ubuntu.session.execute",
      "plugin.ubuntu.command",
      "plugin.ubuntu.filesystem",
      "plugin.ubuntu.process",
      "plugin.ubuntu.session.input",
      "plugin.ubuntu.session.interrupt",
      "plugin.ubuntu.session.screen",
      "plugin.ubuntu.session.close",
      "plugin.ubuntu.ui_action"
    ],
    "services": [],
    "providers": [
      "plugin.ubuntu.terminal_panel"
    ],
    "extensions": [
      {
        "point": "ai_limbs.ui.home_tile",
        "id": "plugin.system.ubuntu_terminal.tile",
        "api": 1
      },
      {
        "point": "ai_limbs.ui.screen",
        "id": "plugin.system_environment.screen",
        "api": 2
      }
    ]
  }
}
