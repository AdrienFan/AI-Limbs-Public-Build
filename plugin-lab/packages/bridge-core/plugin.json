{
  "format": "AIL_PLUGIN_V1",
  "schema_version": 1,
  "plugin_id": "plugin.system.bridge",
  "version": "1.3.4",
  "api": {
    "target": 1,
    "min": 1
  },
  "display": {
    "name": "Bridge",
    "description": "AI Limbs Bridge Core：发布 ai_limbs.bridge.provider@3，由 .ailx 子插件动态提供 RDC、TRIGGERcmd 等 Bridge Provider。"
  },
  "roles": [
    "system_bridge"
  ],
  "activation": {
    "mode": "hot"
  },
  "runtime": {
    "kind": "android_inprocess",
    "entry": "payload/plugin.apk",
    "config": {
      "entry_class": "com.ai.limbs.plugins.bridge.BridgePluginEntry"
    }
  },
  "dependencies": {
    "plugins": [],
    "services": []
  },
  "permissions": {
    "requested_scopes": [
      "host.notification@1"
    ]
  },
  "provides": {
    "capabilities": [
      "plugin.bridge.select_provider"
    ],
    "services": [],
    "providers": [
      "plugin.bridge.control_panel"
    ],
    "extensions": [
      {
        "point": "ai_limbs.ui.home_tile",
        "id": "plugin.system.bridge.tile",
        "api": 1
      },
      {
        "point": "ai_limbs.ui.screen",
        "id": "plugin.system.bridge.screen",
        "api": 2
      }
    ]
  }
}
