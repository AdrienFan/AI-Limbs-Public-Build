{
  "format": "AIL_PLUGIN_V1",
  "schema_version": 1,
  "plugin_id": "plugin.system.extension_hub",
  "version": "1.4.1",
  "api": {
    "target": 1,
    "min": 1
  },
  "display": {
    "name": "Plugin Extension Hub",
    "description": "AI Limbs 子插件管理器：对 AIL_EXTENSION_V1 / .ailx 执行完整性、发布者信任、安装、挂载、备份、导出与生命周期管理。"
  },
  "roles": [
    "system_extension_hub"
  ],
  "activation": {
    "mode": "hot"
  },
  "runtime": {
    "kind": "android_inprocess",
    "entry": "payload/plugin.apk",
    "config": {
      "entry_class": "com.ai.limbs.plugins.extensionhub.ExtensionHubEntry"
    }
  },
  "dependencies": {
    "plugins": [],
    "services": [
      {
        "id": "system.plugin_center.delegated_gateway",
        "min_api": 1
      }
    ]
  },
  "permissions": {
    "requested_scopes": []
  },
  "provides": {
    "capabilities": [
      "plugin.extension_hub.export_backups"
    ],
    "services": [],
    "providers": [
      "system.extension.hub"
    ],
    "extensions": []
  }
}
