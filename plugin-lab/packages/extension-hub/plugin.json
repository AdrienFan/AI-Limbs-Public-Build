{
  "format": "AIL_PLUGIN_V1",
  "schema_version": 1,
  "plugin_id": "plugin.system.extension_hub",
  "version": "1.5.4",
  "api": {
    "target": 1,
    "min": 1
  },
  "display": {
    "name": "Plugin Extension Hub",
    "description": "AI Limbs 子插件准入网关：对 AIL_EXTENSION_V1 / .ailx 执行结构、完整性与发布者信任验证，并将验证通过的包转交 Host Child Runtime 安装。"
  },
  "roles": [
    "system_extension_hub"
  ],
  "activation": {
    "mode": "hot"
  },
  "runtime": {
    "kind": "android_inprocess",
    "entry": "payload/plugin.apk",
    "config": {
      "entry_class": "com.ai.limbs.plugins.extensionhub.ExtensionHubEntry"
    }
  },
  "dependencies": {
    "plugins": [],
    "services": [
      {
        "id": "system.plugin_center.delegated_gateway",
        "min_api": 1
      }
    ]
  },
  "permissions": {
    "requested_scopes": []
  },
  "provides": {
    "capabilities": [],
    "services": [],
    "providers": [
      "system.extension.hub"
    ],
    "extensions": []
  }
}
